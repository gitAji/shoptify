<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        {%- if settings.logo -%}
          {{ settings.logo | image_url: width: 160 | image_tag: width: 120, alt: shop.name, class: 'site-footer__logo' }}
        {%- else -%}
          <p class="site-footer__logo-text">{{ shop.name }}</p>
        {%- endif -%}
        {%- if section.settings.about_text != blank -%}
          <div class="site-footer__about">{{ section.settings.about_text }}</div>
        {%- endif -%}
        <ul class="site-footer__social">
          {%- if settings.social_instagram_link != blank -%}<li><a href="{{ settings.social_instagram_link }}" aria-label="Instagram">{% render 'icon', name: 'instagram', size: 18 %}</a></li>{%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}<li><a href="{{ settings.social_tiktok_link }}" aria-label="TikTok">{% render 'icon', name: 'tiktok', size: 18 %}</a></li>{%- endif -%}
          {%- if settings.social_facebook_link != blank -%}<li><a href="{{ settings.social_facebook_link }}" aria-label="Facebook">{% render 'icon', name: 'facebook', size: 18 %}</a></li>{%- endif -%}
          {%- if settings.social_pinterest_link != blank -%}<li><a href="{{ settings.social_pinterest_link }}" aria-label="Pinterest">{% render 'icon', name: 'pinterest', size: 18 %}</a></li>{%- endif -%}
          {%- if settings.social_x_link != blank -%}<li><a href="{{ settings.social_x_link }}" aria-label="X">{% render 'icon', name: 'x', size: 18 %}</a></li>{%- endif -%}
        </ul>
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div class="site-footer__col" {{ block.shopify_attributes }}>
              <h3 class="site-footer__heading">{{ block.settings.heading }}</h3>
              <ul>
                {%- for link in linklists[block.settings.menu].links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- when 'text' -%}
            <div class="site-footer__col" {{ block.shopify_attributes }}>
              <h3 class="site-footer__heading">{{ block.settings.heading }}</h3>
              <div class="site-footer__text">{{ block.settings.text }}</div>
            </div>
          {%- when 'newsletter' -%}
            <div class="site-footer__col" {{ block.shopify_attributes }}>
              <h3 class="site-footer__heading">{{ block.settings.heading }}</h3>
              <p class="site-footer__text">{{ block.settings.text }}</p>
              {%- form 'customer', class: 'newsletter-form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="newsletter-form__row">
                  <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter.email_placeholder' | t }}" required aria-label="{{ 'general.newsletter.email_placeholder' | t }}">
                  <button type="submit" class="button button--primary">{{ 'general.newsletter.submit' | t }}</button>
                </div>
                {%- if form.posted_successfully? -%}
                  <p class="form-success">{{ 'general.newsletter.success' | t }}</p>
                {%- endif -%}
              {%- endform -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.bottom_text }}</p>
      <ul class="site-footer__trust">
        <li>{% render 'icon', name: 'shield-check', size: 14 %} {{ 'products.product.authenticity' | t }}</li>
        <li>{% render 'icon', name: 'recycle', size: 14 %} Circular fashion</li>
      </ul>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "richtext",
      "id": "about_text",
      "label": "About text",
      "default": "<p>We buy, inspect, and resell pre-loved and surplus goods — extending their story instead of the landfill's.</p>"
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom bar text",
      "default": "All rights reserved."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text block",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Help" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Add shipping, returns, or contact info here.</p>" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Stay in the loop" },
        { "type": "text", "id": "text", "label": "Text", "default": "New drops, restocks, and resale tips." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu" },
      { "type": "text" },
      { "type": "newsletter" }
    ]
  }
}
{% endschema %}
