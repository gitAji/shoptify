{%- comment -%}
  Renders a price block with resale savings messaging.
  Usage: {% render 'price', product: product, variant: current_variant %}
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign compare_at_price = target.compare_at_price
  assign price = target.price
  assign on_sale = false
  if compare_at_price > price
    assign on_sale = true
  endif
-%}
<div class="price{% if on_sale %} price--on-sale{% endif %}">
  {%- if on_sale -%}
    <span class="price__compare">
      <span class="visually-hidden">{{ settings.compare_at_price_label }}:</span>
      <s>{{ compare_at_price | money }}</s>
    </span>
  {%- endif -%}
  <span class="price__current">{{ price | money }}</span>
  {%- if on_sale and settings.show_savings_badge -%}
    {%- assign savings_pct = compare_at_price | minus: price | times: 100.0 | divided_by: compare_at_price | round -%}
    <span class="badge badge--savings">{{ 'products.product.save_percentage' | t: percentage: savings_pct }}</span>
  {%- endif -%}
</div>
