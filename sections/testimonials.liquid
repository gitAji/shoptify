<section class="testimonials">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-heading section-heading--center">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="testimonials__grid">
      {%- for block in section.blocks -%}
        <blockquote class="testimonial" {{ block.shopify_attributes }}>
          <div class="testimonial__stars">
            {%- for i in (1..5) -%}
              {% render 'icon', name: 'star', size: 14 %}
            {%- endfor -%}
          </div>
          <p class="testimonial__quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
          <cite class="testimonial__author">{{ block.settings.author }}</cite>
        </blockquote>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by resale shoppers" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Better than new — the condition notes were spot on and it arrived so fast." },
        { "type": "text", "id": "author", "label": "Author", "default": "Jordan M." }
      ]
    }
  ],
  "max_blocks": 6,
  "default": {
    "blocks": [
      { "type": "testimonial", "settings": { "quote": "Better than new — the condition notes were spot on and it arrived so fast.", "author": "Jordan M." } },
      { "type": "testimonial", "settings": { "quote": "I sold three bags through their trade-in program and got paid within a week.", "author": "Priya S." } },
      { "type": "testimonial", "settings": { "quote": "My go-to for pre-loved staples. Every item feels genuinely inspected.", "author": "Alex T." } }
    ]
  }
}
{% endschema %}
