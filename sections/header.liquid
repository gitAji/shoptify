{%- liquid
  assign menu = linklists[section.settings.menu]
  assign logo_width_2x = settings.logo_width | times: 2
-%}

{%- if section.settings.announcement_text != blank -%}
  <div class="announcement-bar">
    {%- if section.settings.announcement_link != blank -%}
      <a href="{{ section.settings.announcement_link }}">{{ section.settings.announcement_text }}</a>
    {%- else -%}
      <p>{{ section.settings.announcement_text }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <button type="button" class="icon-button site-header__menu-toggle" data-menu-drawer-toggle aria-expanded="false" aria-controls="menu-drawer">
      {% render 'icon', name: 'menu', size: 22 %}
      <span class="visually-hidden">{{ 'general.accessibility.menu' | t }}</span>
    </button>

    <a href="{{ routes.root_url }}" class="site-header__logo">
      {%- if settings.logo -%}
        {{ settings.logo | image_url: width: logo_width_2x | image_tag: width: settings.logo_width, alt: shop.name }}
      {%- else -%}
        <span class="site-header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul class="site-header__nav-list">
        {%- for link in menu.links -%}
          <li class="site-header__nav-item{% if link.links != blank %} has-dropdown{% endif %}">
            <a href="{{ link.url }}" class="site-header__nav-link"{% if link.active %} aria-current="page"{% endif %}>
              {{ link.title }}
              {%- if link.links != blank %} {% render 'icon', name: 'chevron-down', size: 12 %}{% endif -%}
            </a>
            {%- if link.links != blank -%}
              <ul class="site-header__dropdown">
                {%- for child_link in link.links -%}
                  <li><a href="{{ child_link.url }}">{{ child_link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="site-header__actions">
      <button type="button" class="icon-button" data-search-drawer-toggle aria-label="{{ 'general.accessibility.search' | t }}">
        {% render 'icon', name: 'search', size: 20 %}
      </button>
      <a href="{{ routes.account_url }}" class="icon-button" aria-label="{{ 'customer.account.title' | t }}">
        {% render 'icon', name: 'account', size: 20 %}
      </a>
      <button type="button" class="icon-button site-header__cart-toggle" data-cart-drawer-toggle aria-label="{{ 'cart.general.title' | t }}">
        {% render 'icon', name: 'cart', size: 20 %}
        <span class="cart-count-bubble" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </button>
    </div>
  </div>
</header>

<div id="menu-drawer" class="menu-drawer" aria-hidden="true">
  <div class="menu-drawer__overlay" data-menu-drawer-close></div>
  <div class="menu-drawer__panel">
    <div class="menu-drawer__header">
      <span class="site-header__logo-text">{{ shop.name }}</span>
      <button type="button" class="icon-button" data-menu-drawer-close aria-label="{{ 'general.accessibility.close' | t }}">
        {% render 'icon', name: 'close', size: 18 %}
      </button>
    </div>
    <ul class="menu-drawer__list">
      {%- for link in menu.links -%}
        <li>
          <a href="{{ link.url }}">{{ link.title }}</a>
          {%- if link.links != blank -%}
            <ul class="menu-drawer__sublist">
              {%- for child_link in link.links -%}
                <li><a href="{{ child_link.url }}">{{ child_link.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    <ul class="menu-drawer__list menu-drawer__list--secondary">
      <li><a href="{{ routes.account_url }}">{{ 'customer.account.title' | t }}</a></li>
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Announcement bar"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "Free shipping on orders over $75 · All items authenticated"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement link"
    }
  ]
}
{% endschema %}
