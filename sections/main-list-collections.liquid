<section class="list-collections">
  <div class="container">
    <h1 class="section-heading">{{ section.settings.heading }}</h1>
    <div class="list-collections__grid">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="collection-card">
          <div class="collection-card__media">
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 30vw, 90vw', widths: '350,500,700', alt: collection.title }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'collection-card__placeholder' }}
            {%- endif -%}
          </div>
          <h2 class="collection-card__title">{{ collection.title }}</h2>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" }
  ]
}
{% endschema %}
