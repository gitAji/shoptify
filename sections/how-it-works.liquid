<section class="how-it-works">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-heading section-heading--center">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="section-subheading section-subheading--center">{{ section.settings.subheading }}</p>
    {%- endif -%}
    <ol class="how-it-works__steps">
      {%- for block in section.blocks -%}
        <li class="how-it-works__step" {{ block.shopify_attributes }}>
          <span class="how-it-works__number">{{ forloop.index }}</span>
          <h3 class="how-it-works__title">{{ block.settings.title }}</h3>
          <p class="how-it-works__text">{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Selling with us is simple" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Turn your closet or storeroom into cash in four easy steps." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Submit your items" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell us what you're looking to sell using our quick intake form.</p>" }
      ]
    }
  ],
  "max_blocks": 6,
  "default": {
    "blocks": [
      { "type": "step", "settings": { "title": "Submit your items", "text": "<p>Tell us what you're looking to sell using our quick intake form.</p>" } },
      { "type": "step", "settings": { "title": "Ship or drop off", "text": "<p>Send items in with a prepaid label, or drop them at a partner location.</p>" } },
      { "type": "step", "settings": { "title": "We authenticate & list", "text": "<p>Our team inspects, prices, photographs, and lists each piece.</p>" } },
      { "type": "step", "settings": { "title": "Get paid", "text": "<p>Once your item sells, your payout is sent directly to you.</p>" } }
    ]
  }
}
{% endschema %}
