<section class="newsletter-section">
  <div class="container newsletter-section__inner">
    <div>
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="section-subheading">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter-form__row">
        <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter.email_placeholder' | t }}" required aria-label="{{ 'general.newsletter.email_placeholder' | t }}">
        <button type="submit" class="button button--primary">{{ 'general.newsletter.submit' | t }}</button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="form-success">{{ 'general.newsletter.success' | t }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Never miss a drop" },
    { "type": "text", "id": "text", "label": "Text", "default": "New arrivals land daily. Get first pick." }
  ],
  "presets": [
    { "name": "Newsletter" }
  ]
}
{% endschema %}
