<div id="search-drawer" class="search-drawer" aria-hidden="true">
  <div class="search-drawer__overlay" data-search-drawer-close></div>
  <div class="search-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'general.accessibility.search' | t }}">
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-drawer__form">
      {% render 'icon', name: 'search', size: 20 %}
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'general.search.placeholder' | t }}"
        class="search-drawer__input"
        autocomplete="off"
        data-search-input
      >
      <input type="hidden" name="type" value="product">
      <button type="button" class="icon-button" data-search-drawer-close aria-label="{{ 'general.accessibility.close' | t }}">
        {% render 'icon', name: 'close', size: 18 %}
      </button>
    </form>
  </div>
</div>
