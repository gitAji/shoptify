<section class="trust-badges">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-heading section-heading--center">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="trust-badges__grid">
      {%- for block in section.blocks -%}
        <div class="trust-badges__item" {{ block.shopify_attributes }}>
          <div class="trust-badges__icon">{% render 'icon', name: block.settings.icon, size: 28 %}</div>
          <h3 class="trust-badges__title">{{ block.settings.title }}</h3>
          <p class="trust-badges__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust badges",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Buy secondhand with confidence" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield-check", "label": "Shield check" },
            { "value": "truck", "label": "Truck" },
            { "value": "recycle", "label": "Recycle" },
            { "value": "tag", "label": "Tag" },
            { "value": "package", "label": "Package" },
            { "value": "wallet", "label": "Wallet" },
            { "value": "heart", "label": "Heart" }
          ],
          "default": "shield-check"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Authenticated" },
        { "type": "text", "id": "text", "label": "Text", "default": "Every item is inspected by our team before listing." }
      ]
    }
  ],
  "max_blocks": 4,
  "default": {
    "blocks": [
      { "type": "badge", "settings": { "icon": "shield-check", "title": "Authenticated", "text": "Every item is inspected by our team before listing." } },
      { "type": "badge", "settings": { "icon": "truck", "title": "Fast, tracked shipping", "text": "Most orders ship within 1-2 business days." } },
      { "type": "badge", "settings": { "icon": "package", "title": "Easy 14-day returns", "text": "Not the right fit? Send it back, no questions asked." } },
      { "type": "badge", "settings": { "icon": "recycle", "title": "Better for the planet", "text": "Buying resale keeps good things out of landfill." } }
    ]
  }
}
{% endschema %}
