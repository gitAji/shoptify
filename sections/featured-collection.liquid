<section class="featured-collection">
  <div class="container">
    <div class="section-header">
      <div>
        {%- if section.settings.heading != blank -%}
          <h2 class="section-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="section-subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.collection != blank -%}
        <a href="{{ section.settings.collection.url }}" class="section-header__link">View all {% render 'icon', name: 'chevron-right', size: 14 %}</a>
      {%- endif -%}
    </div>

    <div class="product-grid product-grid--{{ section.settings.columns_desktop }}-col">
      {%- if section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          <div class="product-grid__item">{% render 'product-card', product: product %}</div>
        {%- else -%}
          {%- for i in (1..section.settings.products_to_show) -%}
            <div class="product-grid__item product-grid__item--empty">
              {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}
            </div>
          {%- endfor -%}
        {%- endfor -%}
      {%- else -%}
        <p class="empty-state">{{ 'Select a collection to display products here.' }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New arrivals" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Just in — inspected, priced, and ready to ship." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 8 },
    { "type": "select", "id": "columns_desktop", "label": "Columns on desktop", "options": [
      { "value": "3", "label": "3" },
      { "value": "4", "label": "4" },
      { "value": "5", "label": "5" }
    ], "default": "4" }
  ],
  "presets": [
    { "name": "Featured collection" }
  ]
}
{% endschema %}
